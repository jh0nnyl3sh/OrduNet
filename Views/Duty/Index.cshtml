@model List<OrduNet.Web.Models.Entities.DailyDuty>
@{
    ViewData["Title"] = "Nöbet Çizelgesi";
}

<div class="container py-4">
    <div class="section-heading">
        <h2>Nöbetçi Mahkemeler & Savcılık Çizelgesi</h2>
        <span class="badge bg-warning text-dark px-3 py-2 fw-bold">
            <i class="bi bi-calendar-check me-1"></i> GÖncel Nöbet Listesi
        </span>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nöbet Tarihi</th>
                        <th>Nöbet Türü</th>
                        <th>Görevli Mahkeme / Savcı / Birim</th>
                        <th>Dahili & İletişim</th>
                        <th>Konum / Duruşma Salonu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary">@item.DutyDate.ToString("dd.MM.yyyy dddd")</span>
                            </td>
                            <td class="fw-bold text-primary" style="color: var(--primary-color) !important;">
                                @item.DutyType
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.DutyOfficerOrUnit</div>
                            </td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success p-2">
                                    <i class="bi bi-telephone-fill me-1"></i> @item.ContactInfo
                                </span>
                            </td>
                            <td>
                                <i class="bi bi-geo-alt-fill text-muted me-1"></i> @(item.Location ?? "-")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Sayfalama (Pagination) -->
        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 border-top-0">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link text-dark" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i> Önceki
                            </a>
                        </li>
                        
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                <a class="page-link @(ViewBag.CurrentPage == i ? "bg-dark border-dark text-white" : "text-dark")" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                        
                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link text-dark" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">
                                Sonraki <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>

    <div class="alert alert-secondary small">
        <i class="bi bi-info-circle-fill me-1"></i> Nöbet değişiklikleri ve haftasonu acil görevlendirmeler Adalet Komisyonu Bağkanlççç ve Cumhuriyet Bağsavcılççç nöbet talimatlarına tabidir.
    </div>
</div>
