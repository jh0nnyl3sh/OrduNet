@model List<OrduNet.Web.Models.Entities.Unit>
@{
    ViewData["Title"] = "Birim / Mahkeme Yönetimi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-primary" style="color: var(--primary-color) !important;">
                <i class="bi bi-diagram-3-fill text-warning me-2"></i> Birim & Mahkeme Yönetimi
            </h2>
            <div class="text-muted small">Adliye birimlerini, mahkemeleri ve kategorilerini düzenleyin</div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Panoya Dön
            </a>
            <button type="button" class="btn btn-outline-success btn-sm fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#excelUnitsModal">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Excel İle Toplu Ekle
            </button>
            <button type="button" class="btn btn-warning btn-sm fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#newUnitModal">
                <i class="bi bi-plus-circle me-1"></i> Yeni Birim Ekle
            </button>
        </div>
    </div>



    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">Sıra</th>
                        <th>Birim / Mahkeme Adı</th>
                        <th>Konum / Kat</th>
                        <th class="text-end" style="width: 100px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@u.DisplayOrder</span></td>
                            <td class="fw-bold text-dark">@u.Name</td>
                            <td class="text-muted"><i class="bi bi-geo-alt me-1"></i> @(u.Location ?? "-")</td>
                            <td class="text-end">
                                <a asp-action="EditUnit" asp-route-id="@u.Id" class="btn btn-outline-primary btn-sm" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteUnit" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('@u.Name birimi silinecek. Onaylıyor musunuz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- YENİ BİRİM MODAL -->
<div class="modal fade" id="newUnitModal" tabindex="-1" aria-labelledby="newUnitModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background-color: var(--primary-color);">
                <h5 class="modal-title" id="newUnitModalLabel"><i class="bi bi-plus-circle text-warning me-2"></i> Yeni Birim Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="CreateUnit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Birim / Mahkeme Adı *</label>
                        <input type="text" name="Name" class="form-control" required placeholder="Örn: 3. Ağır Ceza Mahkemesi" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kategori *</label>
                        <select name="Category" class="form-select" required>
                            <option value="Cumhuriyet Başsavcılığı">Cumhuriyet Başsavcılığı</option>
                            <option value="Ceza Mahkemeleri">Ceza Mahkemeleri</option>
                            <option value="Hukuk Mahkemeleri">Hukuk Mahkemeleri</option>
                            <option value="İcra & İflas">İcra & İflas</option>
                            <option value="İdari Birimler">İdari Birimler</option>
                            <option value="Diğer">Diğer</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Konum / Kat / Kalem No</label>
                        <input type="text" name="Location" class="form-control" placeholder="Örn: 2. Kat - Kalem 210" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Göruntülenme Sıralaması</label>
                        <input type="number" name="DisplayOrder" class="form-control" value="50" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EXCEL İLE TOPLU BİRİM YÜKLEME MODAL -->
<div class="modal fade" id="excelUnitsModal" tabindex="-1" aria-labelledby="excelUnitsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background-color: #153b44;">
                <h5 class="modal-title" id="excelUnitsModalLabel">
                    <i class="bi bi-file-earmark-excel-fill text-success me-2"></i> Excel İle Toplu Birim / Mahkeme Yükle
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form asp-action="UploadUnitsExcel" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="alert alert-light border small text-muted mb-3">
                        <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle text-primary me-1"></i> Toplu Yükleme Bilgisi</div>
                        Excel dosyanızda <strong>Birim Adı, Kategori, Konum</strong> ve <strong>Sıralama</strong> sütunları yer almalıdır. Sistemdeki mevcut birimler güncellenir, yeni birimler otomatik eklenir.
                    </div>

                    <div class="mb-3">
                        <a asp-action="DownloadUnitTemplate" class="btn btn-outline-success btn-sm w-100 fw-semibold">
                            <i class="bi bi-download me-1"></i> Örnek Excel Şablonunu İndir (.xlsx)
                        </a>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Excel Dosyası Seçiniz (.xlsx veya .xls) *</label>
                        <input type="file" name="file" class="form-control" accept=".xlsx, .xls" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning btn-sm fw-bold text-dark shadow-sm">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Excel'i Yükle & Sisteme Aktar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
