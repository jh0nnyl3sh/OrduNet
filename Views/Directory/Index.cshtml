@model OrduNet.Web.Models.ViewModels.DirectoryViewModel
@using OrduNet.Web.Services
@using OrduNet.Web.Models.Entities
@{
    ViewData["Title"] = "Dahili Telefon Rehberi";
    bool canManageDirectory = User.Identity?.IsAuthenticated == true && User.HasModulePermission(SystemModules.Directory);
}

<!-- 1. HERO ARAMA BÖLÜMÜ -->
<div class="directory-hero">
    <div class="container text-center">
        <div class="d-inline-flex align-items-center gap-2 mb-2 px-3 py-1 bg-white bg-opacity-10 rounded-pill text-warning small fw-bold">
            <i class="bi bi-shield-check"></i> Ordu Adalet Sarayı Dahili İletişim Ağı
        </div>
        <h2 class="fw-bolder mb-2 text-white">Kurumiçi Telefon Rehberi</h2>
        <p class="text-white-50 mb-4 small">Ad, soyad, unvan, mahkeme/kalem adı, oda no veya dahili numara ile anında arama yapabilirsiniz.</p>

        <!-- CANLI ARAMA KUTUSU -->
        <div class="search-container">
            <div class="search-input-group">
                <i class="bi bi-search text-muted fs-5 me-2"></i>
                <input type="text" id="directorySearchInput" placeholder="Personel adı, unvan, dahili no veya birim yazınız..." autocomplete="off" autofocus />
                <button type="button" id="btnClearSearch" class="btn-clear-search" title="Aramayı Temizle">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
                <div class="btn-search-icon">
                    <i class="bi bi-arrow-right"></i>
                </div>
            </div>

            <!-- KATEGORİ FİLTRE DÜĞMELERİ -->
            <div class="category-pills">
                <button type="button" class="pill-btn category-pill-btn active" data-category="Tümü">
                    <i class="bi bi-grid-fill me-1"></i> Tümü (@Model.TotalPersonnelCount)
                </button>
                @foreach (var cat in Model.Categories)
                {
                    <button type="button" class="pill-btn category-pill-btn" data-category="@cat">
                        @cat
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- 2. REHBER TABLOSU VE İŞLEM ÇUBUĞU -->
<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <span id="resultCountBadge" class="badge bg-primary px-3 py-2 fs-6 rounded-pill" style="background-color: var(--primary-color) !important;">
                @Model.PersonnelList.Count Kayıt Listeleniyor
            </span>
            <small class="text-muted d-none d-md-inline">Dahili numaraya tıklayarak panoya kopyalayabilirsiniz.</small>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <!-- Excel indir -->
            <a asp-action="ExportExcel" class="btn btn-outline-success btn-sm fw-semibold shadow-sm">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Excel Olarak indir
            </a>
            <!-- Yazdır / PDF -->
            <a asp-action="Print" target="_blank" class="btn btn-outline-secondary btn-sm fw-semibold shadow-sm">
                <i class="bi bi-printer-fill me-1"></i> Yazdır / A4 Çıktı
            </a>

            @if (canManageDirectory)
            {
                <!-- Yönetici Eylemleri (Sadece Yetkili Kullanıcılara) -->
                <a asp-controller="Admin" asp-action="PersonnelList" class="btn btn-outline-dark btn-sm fw-semibold shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Rehberi Düzenle
                </a>
                <a asp-controller="Admin" asp-action="CreatePersonnel" class="btn btn-primary btn-sm fw-semibold shadow-sm" style="background-color: var(--primary-color); border-color: var(--primary-color);">
                    <i class="bi bi-person-plus-fill me-1"></i> Yeni Kayıt Ekle
                </a>
                <a asp-controller="Admin" asp-action="ExcelImport" class="btn btn-outline-success btn-sm fw-semibold shadow-sm">
                    <i class="bi bi-file-earmark-excel-fill me-1"></i> Excel ile Toplu Ekle
                </a>
            }
        </div>
    </div>

    <!-- TABLO ALANI -->
    <div class="directory-table-card">
        <div class="table-responsive">
            <table class="table table-hover table-cüstom align-middle">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">#</th>
                        <th>Ad Soyad & Unvan</th>
                        <th>Bağlı Olduğu Birim</th>
                        <th>Dahili Numara</th>
                        <th>Oda & Kat</th>
                        <th class="text-center">İletişim</th>
                        @if (canManageDirectory)
                        {
                            <th class="text-end" style="width: 80px;">Yönet</th>
                        }
                    </tr>
                </thead>
                <tbody id="directoryTableBody">
                    @{ int index = (Model.CurrentPage - 1) * Model.PageSize + 1; }
                    @foreach (var p in Model.PersonnelList)
                    {
                        <tr>
                            <td class="text-center text-muted">@(index++)</td>
                            <td>
                                <div class="personnel-name">@p.FullName</div>
                                <div class="personnel-title">@p.Title</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@(p.Unit?.Name ?? "-")</div>
                                <small class="badge bg-light text-secondary border">@(p.Unit?.Category ?? "-")</small>
                            </td>
                            <td>
                                <span class="internal-badge copy-internal" data-number="@p.InternalNumber" title="Tıkla ve Dahiliyi Kopyala">
                                    <i class="bi bi-telephone-fill"></i> @p.InternalNumber
                                </span>
                                @if (!string.IsNullOrEmpty(p.InternalNumber2))
                                {
                                    <span class="text-muted ms-1">/ @p.InternalNumber2</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.RoomNumber))
                                {
                                    <span class="room-badge"><i class="bi bi-door-closed me-1"></i>Oda: @p.RoomNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                                @if (!string.IsNullOrEmpty(p.Floor))
                                {
                                    <small class="badge bg-light text-dark border d-inline-block mt-1">
                                        <i class="bi bi-layers me-1 text-secondary"></i>@p.Floor
                                    </small>
                                }
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(p.Email))
                                {
                                    <a href="mailto:@p.Email" class="text-decoration-none text-muted" title="@p.Email">
                                        <i class="bi bi-envelope fs-5"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            @if (canManageDirectory)
                            {
                                <td class="text-end">
                                    <a asp-controller="Admin" asp-action="EditPersonnel" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm py-0 px-2" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Sayfalama (Pagination) -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 border-top-0">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link text-dark" asp-action="Index" 
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-category="@Model.SelectedCategory" 
                               asp-route-unitId="@Model.SelectedUnitId" 
                               asp-route-page="@(Model.CurrentPage - 1)">
                                <i class="bi bi-chevron-left"></i> Önceki
                            </a>
                        </li>
                        
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            // çok fazla sayfa varsa sayfalama görunümünü kısaltmak için (opsiyonel basit mantık eklenebilir ama şu an tüm sayfaları basıyoruz)
                            // Sayfa sayısı çok olursa taşabilir ancak genelde 1-10 arası idare eder.
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link @(Model.CurrentPage == i ? "bg-dark border-dark text-white" : "text-dark")" 
                                   asp-action="Index" 
                                   asp-route-search="@Model.SearchTerm" 
                                   asp-route-category="@Model.SelectedCategory" 
                                   asp-route-unitId="@Model.SelectedUnitId" 
                                   asp-route-page="@i">@i</a>
                            </li>
                        }
                        
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link text-dark" asp-action="Index" 
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-category="@Model.SelectedCategory" 
                               asp-route-unitId="@Model.SelectedUnitId" 
                               asp-route-page="@(Model.CurrentPage + 1)">
                                Sonraki <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }

        <!-- SONUÇ BULUNAMADI UYARISI -->
        <div id="noResultsDiv" class="text-center py-5" style="display: none;">
            <div class="display-6 text-muted mb-3"><i class="bi bi-search"></i></div>
            <h5 class="fw-bold text-secondary">Aramanıza Uygun Kayıt Bulunamadı</h5>
            <p class="text-muted small">Lütfen arama teriminizi kontrol ediniz veya filtreyi "Tümü" olarak değiştiriniz.</p>
        </div>
    </div>
</div>
