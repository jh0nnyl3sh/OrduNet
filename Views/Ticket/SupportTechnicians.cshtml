@model List<OrduNet.Web.Models.Entities.SupportTechnician>
@{
    ViewData["Title"] = "Teknik Destek Ekibi & İzin Yönetimi";
    Layout = "_Layout";
    var activeCount = Model.Count(t => t.IsAvailable);
    var onLeaveCount = Model.Count(t => !t.IsAvailable);
}

<div class="container py-4">
    <!-- Breadcrumb & Başlık -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none text-muted">Yönetim Paneli</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Ticket" asp-action="Index" class="text-decoration-none text-muted">Arıza Talepleri</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Teknik Ekip & İzin Yönetimi</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-people-fill text-primary me-2"></i> Teknik Servis Ekibi & İzin Takibi</h3>
            <small class="text-muted">Arızalara bakacak personelleri listeleyin, o gün izinli olanları pasife alarak arıza yönlendirmesini yönetin.</small>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-warning btn-sm fw-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#addTechnicianModal">
                <i class="bi bi-person-plus-fill me-1"></i> Yeni Personel Ekle
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Arıza Taleplerine Dön
            </a>
        </div>
    </div>



    <!-- Durum Sayaçları -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Toplam Teknik Personel</div>
                        <div class="fs-4 fw-bold text-dark">@Model.Count</div>
                    </div>
                    <div class="rounded-circle bg-secondary bg-opacity-10 p-3 text-secondary">
                        <i class="bi bi-person-badge fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-success small fw-semibold">Görevde (Arıza Atanabilir)</div>
                        <div class="fs-4 fw-bold text-success">@activeCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="bi bi-person-check-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-warning-emphasis small fw-semibold">İzinli / Pasif (Atama Yapılamaz)</div>
                        <div class="fs-4 fw-bold text-warning-emphasis">@onLeaveCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning-emphasis">
                        <i class="bi bi-calendar-x-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Personel Listesi Tablosu -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark"><i class="bi bi-card-list me-1"></i> Teknik Destek & Saha Personeli Listesi</span>
            <span class="small text-muted">İzinli personeller arıza yönlendirme ekranında otomatik devre dışı kalır.</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Unvan / Uzmanlık</th>
                        <th>Kategoriler</th>
                        <th>Dahili / Telefon</th>
                        <th class="text-center">Günlük Durum</th>
                        <th class="text-end" style="width: 280px;">Durum & İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                                Henüz kayıtlı teknik personel bulunmuyor. Yukarıdaki butondan ekleyebilirsiniz.
                            </td>
                        </tr>
                    }
                    @foreach (var tech in Model)
                    {
                        <tr class="@(!tech.IsAvailable ? "bg-light bg-opacity-50" : "")">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle @(tech.IsAvailable ? "bg-success" : "bg-warning") text-white d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 0.9rem; font-weight: bold;">
                                        @tech.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@tech.FullName</div>
                                        <div class="small text-muted">Kayıt: @tech.CreatedAt.ToString("dd.MM.yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">
                                    @(string.IsNullOrEmpty(tech.Title) ? "Teknisyen" : tech.Title)
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(tech.Specialties))
                                {
                                    foreach (var spec in tech.Specialties.Split(','))
                                    {
                                        <span class="badge bg-info text-dark me-1 small">@spec</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Yok</span>
                                }
                            </td>
                            <td class="text-dark small">
                                <i class="bi bi-telephone text-primary me-1"></i>
                                @(string.IsNullOrEmpty(tech.Phone) ? "Belirtilmedi" : tech.Phone)
                            </td>
                            <td class="text-center">
                                @if (tech.IsAvailable)
                                {
                                    <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">
                                        <i class="bi bi-check-circle-fill me-1"></i> Görevde (Aktif)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 fs-6 shadow-sm">
                                        <i class="bi bi-calendar-x-fill me-1"></i> İzinli (Pasif)
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <!-- Hızlı İzin / Görev Değiştirme Butonu -->
                                    <form asp-action="ToggleTechnicianAvailability" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tech.Id" />
                                        @if (tech.IsAvailable)
                                        {
                                            <button type="submit" class="btn btn-outline-warning text-dark btn-sm fw-semibold" title="Bu personeli bugün izinli yap">
                                                <i class="bi bi-pause-circle me-1"></i> İzinli Yap
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm fw-semibold" title="Bu personeli göreve al">
                                                <i class="bi bi-play-circle me-1"></i> Göreve Al
                                            </button>
                                        }
                                    </form>

                                    <!-- Düzenle Butonu -->
                                    <button type="button" class="btn btn-outline-primary btn-sm" title="Düzenle" data-bs-toggle="modal" data-bs-target="#editTechnicianModal-@tech.Id">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <!-- Silme Butonu -->
                                    <form asp-action="DeleteSupportTechnician" method="post" class="d-inline" onsubmit="return confirm('@tech.FullName isimli personeli teknik ekipten silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tech.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Ekipten Çıkar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Yeni Teknisyen Ekleme Modalı -->
<div class="modal fade" id="addTechnicianModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="CreateSupportTechnician" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header bg-light py-2">
                    <h6 class="modal-title fw-bold text-dark">
                        <i class="bi bi-person-plus-fill me-1 text-primary"></i> Yeni Teknik Personel Ekle
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Ad Soyad <span class="text-danger">*</span></label>
                        <input name="FullName" class="form-control form-control-sm" placeholder="Örn: Ahmet YILMAZ" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Unvan / Uzmanlık Alanı</label>
                        <input name="Title" class="form-control form-control-sm" placeholder="Örn: Bilgisayar Mühendisi, Ağ Teknisyeni" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">İletişim / Dahili Telefon</label>
                        <input name="Phone" class="form-control form-control-sm" placeholder="Örn: Dahili 1052 veya 0532..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-2">Uzmanlık Alanları (Kategoriler)</label>
                        <div class="border rounded p-2 bg-white" style="max-height: 150px; overflow-y: auto;">
                            @if (ViewBag.TicketCategories != null)
                            {
                                foreach (var cat in (List<OrduNet.Web.Models.Entities.TicketCategory>)ViewBag.TicketCategories)
                                {
                                    <div class="form-check mb-1">
                                        <input class="form-check-input" type="checkbox" name="SelectedSpecialties" value="@cat.Name" id="add_cat_@cat.Id">
                                        <label class="form-check-label small text-dark" for="add_cat_@cat.Id">
                                            @cat.Name
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                        <div class="form-text small">İlgili personele atanmasını istediğiniz arıza kategorilerini işaretleyiniz.</div>
                    </div>

                    <div class="form-check form-switch pt-2">
                        <input name="IsAvailable" class="form-check-input" type="checkbox" id="techIsAvailable" value="true" checked>
                        <input name="IsAvailable" type="hidden" value="false" />
                        <label class="form-check-label small fw-semibold text-dark" for="techIsAvailable">
                            Hemen Görevde (Aktif) Olarak Başlat
                        </label>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3" style="background-color: var(--primary-color);">
                        <i class="bi bi-check-lg me-1"></i> Personeli Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var tech in Model)
{
    var specList = string.IsNullOrEmpty(tech.Specialties) ? new List<string>() : tech.Specialties.Split(',').ToList();

    <div class="modal fade" id="editTechnicianModal-@tech.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form asp-action="EditSupportTechnician" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@tech.Id" />

                    <div class="modal-header bg-light py-2">
                        <h6 class="modal-title fw-bold text-dark">
                            <i class="bi bi-pencil-square me-1 text-primary"></i> Personel Düzenle
                        </h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-3">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Ad Soyad <span class="text-danger">*</span></label>
                            <input name="FullName" class="form-control form-control-sm" value="@tech.FullName" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Unvan / Uzmanlık Alanı</label>
                            <input name="Title" class="form-control form-control-sm" value="@tech.Title" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">İletişim / Dahili Telefon</label>
                            <input name="Phone" class="form-control form-control-sm" value="@tech.Phone" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark mb-2">Uzmanlık Alanları (Kategoriler)</label>
                            <div class="border rounded p-2 bg-white" style="max-height: 150px; overflow-y: auto;">
                                @if (ViewBag.TicketCategories != null)
                                {
                                    foreach (var cat in (List<OrduNet.Web.Models.Entities.TicketCategory>)ViewBag.TicketCategories)
                                    {
                                        var isChecked = specList.Contains(cat.Name) ? "checked" : "";
                                        <div class="form-check mb-1">
                                            <input class="form-check-input" type="checkbox" name="SelectedSpecialties" value="@cat.Name" id="edit_cat_@(tech.Id)_@(cat.Id)" @isChecked>
                                            <label class="form-check-label small text-dark" for="edit_cat_@(tech.Id)_@(cat.Id)">
                                                @cat.Name
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="form-text small">İlgili personele atanmasını istediğiniz arıza kategorilerini işaretleyiniz.</div>
                        </div>

                        <div class="form-check form-switch pt-2">
                            @if(tech.IsAvailable)
                            {
                                <input name="IsAvailable" class="form-check-input" type="checkbox" id="editTechIsAvailable-@tech.Id" value="true" checked>
                            }
                            else
                            {
                                <input name="IsAvailable" class="form-check-input" type="checkbox" id="editTechIsAvailable-@tech.Id" value="true">
                            }
                            <input name="IsAvailable" type="hidden" value="false" />
                            <label class="form-check-label small fw-semibold text-dark" for="editTechIsAvailable-@tech.Id">
                                Görevde (Aktif)
                            </label>
                        </div>
                    </div>

                    <div class="modal-footer bg-light py-2">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-check-lg me-1"></i> Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
