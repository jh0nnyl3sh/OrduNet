@model List<OrduNet.Web.Models.Entities.TicketCategory>
@{
    ViewData["Title"] = "Arıza Kategorileri";
    Layout = "_Layout";
}

<div class="container py-4">
    <!-- Breadcrumb & Başlık -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none text-muted">Yönetim Paneli</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Arıza Kategorileri</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-tags-fill text-primary me-2"></i> Arıza Kategorileri</h3>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary btn-sm fw-bold text-white shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                <i class="bi bi-plus-lg me-1"></i> Yeni Kategori Ekle
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Geri Dön
            </a>
        </div>
    </div>

    <!-- Kategoriler Tablosu -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Kategori Adı</th>
                        <th class="text-center">Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                Henüz kayıtlı kategori bulunmuyor.
                            </td>
                        </tr>
                    }
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@cat.Name</td>
                            <td class="text-center">
                                @if (cat.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <button type="button" class="btn btn-outline-primary btn-sm" title="Düzenle" data-bs-toggle="modal" data-bs-target="#editCategoryModal_@cat.Id">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <form asp-action="ToggleTicketCategory" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        @if (cat.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-warning btn-sm" title="Pasif Yap">
                                                <i class="bi bi-pause-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm" title="Aktif Yap">
                                                <i class="bi bi-play-circle"></i>
                                            </button>
                                        }
                                    </form>

                                    <form asp-action="DeleteTicketCategory" method="post" class="d-inline" onsubmit="return confirm('@cat.Name kategorisini silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>

                                <!-- Düzenle Kategori Modalı -->
                                <div class="modal fade text-start" id="editCategoryModal_@cat.Id" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <form asp-action="EditTicketCategory" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@cat.Id" />
                                                <div class="modal-header bg-light py-2">
                                                    <h6 class="modal-title fw-bold"><i class="bi bi-pencil me-1"></i> Kategori Düzenle</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-3">
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Kategori Adı <span class="text-danger">*</span></label>
                                                        <input name="Name" class="form-control form-control-sm" required value="@cat.Name" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer py-2">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                                                    <button type="submit" class="btn btn-primary btn-sm px-3">Güncelle</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Yeni Kategori Modalı -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="CreateTicketCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light py-2">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-lg me-1"></i> Yeni Kategori Ekle</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Kategori Adı <span class="text-danger">*</span></label>
                        <input name="Name" class="form-control form-control-sm" required />
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
