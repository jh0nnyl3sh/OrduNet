@model List<OrduNet.Web.Models.Entities.Personnel>
@{
    ViewData["Title"] = "Personel Yönetimi";
    var units = ViewBag.Units as List<OrduNet.Web.Models.Entities.Unit> ?? new List<OrduNet.Web.Models.Entities.Unit>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-primary" style="color: var(--primary-color) !important;">
                <i class="bi bi-people-fill text-warning me-2"></i> Personel & Dahili Yönetimi
            </h2>
            <div class="text-muted small">Toplam @Model.Count personel listeleniyor</div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Panoya Dön
            </a>
            <a asp-action="ExcelImport" class="btn btn-outline-success btn-sm fw-bold shadow-sm">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Excel İle Toplu Ekle
            </a>
            <a asp-action="CreatePersonnel" class="btn btn-warning btn-sm fw-bold text-dark">
                <i class="bi bi-plus-circle me-1"></i> Yeni Kayıt Ekle
            </a>
        </div>
    </div>

    <!-- FİLTRELEME & ARAMA FORMU -->
    <div class="card border-0 shadow-sm p-3 mb-4 rounded-3 bg-light">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="İsim, unvan veya dahili no ile ara..." value="@ViewBag.Search">
                </div>
            </div>
            <div class="col-md-4">
                <select name="unitId" class="form-select form-select-sm">
                    <option value="">-- Tüm Birimler / Mahkemeler --</option>
                    @foreach (var u in units)
                    {
                        <option value="@u.Id" selected="@(ViewBag.SelectedUnitId == u.Id)">@u.Name (@u.Category)</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Filtrele</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Sıfırla</a>
            </div>
        </form>
    </div>

    <!-- PERSONEL TABLOSU -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Adı Soyadı</th>
                        <th>Unvanı</th>
                        <th>Birim / Kategori</th>
                        <th>Dahili No</th>
                        <th>Oda & Kat</th>
                        <th>E-Posta</th>
                        <th class="text-end" style="width: 140px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int index = 1; }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="text-muted">@(index++)</td>
                            <td class="fw-bold text-dark">@p.FullName</td>
                            <td class="text-muted">@p.Title</td>
                            <td>
                                <div>@p.Unit?.Name</div>
                                <small class="badge bg-light text-secondary border">@p.Unit?.Category</small>
                            </td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success p-2">
                                    <i class="bi bi-telephone-fill me-1"></i> @p.InternalNumber
                                </span>
                            </td>
                            <td>
                                <span>@(p.RoomNumber ?? "-")</span>
                                <small class="text-muted d-block">@(p.Floor ?? "")</small>
                            </td>
                            <td>
                                <small class="text-muted">@(p.Email ?? "-")</small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditPersonnel" asp-route-id="@p.Id" class="btn btn-outline-primary" title="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="DeletePersonnel" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('@p.FullName silinecek. Emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
