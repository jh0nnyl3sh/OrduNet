@model OrduNet.Web.Models.Entities.DailyDuty
@{
    ViewData["Title"] = "Nöbetçi Birim Düzenle";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-primary" style="color: var(--primary-color) !important;">
                <i class="bi bi-pencil-square text-warning me-2"></i> Nöbetçi Düzenle
            </h2>
            <div class="text-muted small">Nöbet bilgisi detaylarını güncelleyin</div>
        </div>
        <div>
            <a asp-action="DailyDuties" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> İptal ve Geri Dön
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="EditDailyDuty" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nöbet Tarihi *</label>
                        <input type="date" asp-for="DutyDate" class="form-control" required />
                        <span asp-validation-for="DutyDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nöbet Türü *</label>
                        <input type="text" asp-for="DutyType" class="form-control" required placeholder="Örn: Nöbetçi Ağır Ceza Mahkemesi" />
                        <span asp-validation-for="DutyType" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Görevli Birim / Kişi *</label>
                        <input type="text" asp-for="DutyOfficerOrUnit" class="form-control" required placeholder="Örn: 1. Ağır Ceza Mahkemesi" />
                        <span asp-validation-for="DutyOfficerOrUnit" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">İletişim Bilgisi</label>
                        <input type="text" asp-for="ContactInfo" class="form-control" placeholder="Örn: Dahili 1112" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Yer / Konum</label>
                        <input type="text" asp-for="Location" class="form-control" placeholder="Örn: Zemin Kat" />
                    </div>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
