@model List<OrduNet.Web.Models.Entities.Announcement>
@{
    ViewData["Title"] = "Duyuru & Haber Yönetimi";
    Layout = "_Layout";
    string selectedCat = ViewBag.SelectedCategory as string ?? "Tümç";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none text-muted">Yönetim Paneli</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Duyuru Yönetimi</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-megaphone-fill text-warning me-2"></i> Duyurular & Kurumsal Haberler</h3>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateAnnouncement" class="btn btn-warning btn-sm fw-bold text-dark shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Yeni Duyuru Ekle
            </a>
            <a asp-action="EmergencyAlert" class="btn btn-outline-danger btn-sm shadow-sm" title="Kırmızı Acil Durum şeridi">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> Acil Bant
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Panele Dön
            </a>
        </div>
    </div>



    <!-- İSTATİSTİKLER VE FİLTRE -->
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-3 bg-white border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">Toplam Duyuru & Haber</div>
                        <div class="fs-4 fw-bold text-dark">@ViewBag.TotalCount</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="bi bi-megaphone fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-3 bg-white border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-success small fw-semibold">Yayında Olanlar</div>
                        <div class="fs-4 fw-bold text-success">@ViewBag.ActiveCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="bi bi-broadcast fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 rounded-3 bg-white border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-warning-emphasis small fw-semibold">Kategori Sayısı</div>
                        <div class="fs-4 fw-bold text-dark">@categories.Count</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ARAMA VE FİLTRE FORMU -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body p-3">
            <form method="get" asp-action="Announcements" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Bağlık veya içerikте ara..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                        <select name="category" class="form-select">
                            <option value="Tümç">Tüm Kategoriler</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c" selected="@(selectedCat == c)">@c</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100" style="background-color: var(--primary-color);">
                        <i class="bi bi-funnel me-1"></i> Filtrele
                    </button>
                    <a asp-action="Announcements" class="btn btn-outline-secondary btn-sm" title="Filtreyi Temizle">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- DUYURU TABLOSU -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark"><i class="bi bi-list-stars me-1"></i> Kayıtlı Duyurular (@Model.Count)</span>
            <a asp-action="CreateAnnouncement" class="btn btn-primary btn-sm px-3" style="background-color: var(--primary-color);">
                <i class="bi bi-plus-lg me-1"></i> Yeni Duyuru
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th>Duyuru Başlığı & Özet</th>
                        <th style="width: 130px;">Kategori</th>
                        <th style="width: 120px;">Yayın Tarihi</th>
                        <th class="text-center" style="width: 100px;">Okunma</th>
                        <th class="text-center" style="width: 110px;">Durum</th>
                        <th class="text-end" style="width: 140px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-megaphone fs-1 d-block mb-2 text-secondary"></i>
                                Henüz eklenmiş duyuru bulunmuyor veya aramanıza uygun sonuç bulunamadı.
                            </td>
                        </tr>
                    }
                    @{ int idx = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center text-muted">@(idx++)</td>
                            <td>
                                <div class="fw-bold text-dark">@item.Title</div>
                                <div class="small text-muted" style="max-width: 450px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @item.Summary
                                </div>
                            </td>
                            <td>
                                <span class="badge @item.BadgeClass px-2 py-1 small">@item.Category</span>
                            </td>
                            <td class="small text-muted">
                                <div><i class="bi bi-calendar3 me-1"></i>@item.PublishDate.ToString("dd.MM.yyyy")</div>
                                <div class="text-secondary small">@item.PublishDate.ToString("HH:mm")</div>
                            </td>
                            <td class="text-center text-muted small">
                                <i class="bi bi-eye me-1"></i>@item.ViewCount
                            </td>
                            <td class="text-center">
                                <form asp-action="ToggleAnnouncementStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="badge border-0 @(item.IsActive ? "bg-success" : "bg-secondary") text-white px-2 py-1" style="cursor: pointer;" title="Durumu değiştirmek için tıklayın">
                                        <i class="bi @(item.IsActive ? "bi-check-circle-fill" : "bi-pause-circle-fill") me-1"></i>
                                        @(item.IsActive ? "YAYINDA" : "PASİF")
                                    </button>
                                </form>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditAnnouncement" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#deleteModal_@item.Id" 
                                            title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Silme Onay Modalı -->
                                <div class="modal fade text-start" id="deleteModal_@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-sm">
                                        <div class="modal-content border-0 shadow">
                                            <div class="modal-header bg-danger text-white py-2">
                                                <h6 class="modal-title fw-bold">Duyuruyu Sil</h6>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body p-3">
                                                <p class="small mb-0"><strong>@item.Title</strong> Başlıklı duyuruyu silmek istediğinize emin misiniz?</p>
                                            </div>
                                            <div class="modal-footer bg-light py-2">
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                                                <form asp-action="DeleteAnnouncement" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-danger btn-sm">Evet, Sil</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
