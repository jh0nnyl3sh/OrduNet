@model List<OrduNet.Web.Models.Entities.SiteSetting>
@{
    ViewData["Title"] = "Sistem Ayarları (CMS)";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1 text-primary" style="color: var(--primary-color) !important;">
                <i class="bi bi-gear-fill text-warning me-2"></i> Sistem Ayarları
            </h2>
            <div class="text-muted small">Uygulama genelindeki sabit metinleri ve dahilileri düzenleyin</div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Panoya Dön
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-0">
            <form asp-action="UpdateSettings" method="post">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Grup / Ayar Adı</th>
                                <th>Değer</th>
                                <th>Açıklama</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var setting in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@setting.Key</div>
                                        <div class="small text-muted"><span class="badge bg-secondary">@setting.GroupName</span></div>
                                    </td>
                                    <td>
                                        <input type="text" name="settingsData[@setting.Id]" value="@setting.Value" class="form-control" />
                                    </td>
                                    <td class="text-muted small">
                                        @setting.Description
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 text-end bg-light border-top">
                    <button type="submit" class="btn btn-primary fw-bold">
                        <i class="bi bi-save me-1"></i> Ayarları Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
