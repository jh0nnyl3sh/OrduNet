@model OrduNet.Web.Models.Entities.HelpdeskFaq
@{
    ViewData["Title"] = "SSS Düzenle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-pencil-square text-primary me-2"></i> Soru (Hızlı Yardım) Düzenle</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EditFaq" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mb-3">
                            <label asp-for="Question" class="form-label fw-bold">Soru / Konu</label>
                            <input asp-for="Question" class="form-control" required />
                            <span asp-validation-for="Question" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Answer" class="form-label fw-bold">çözüm / Cevap</label>
                            <textarea asp-for="Answer" class="form-control" rows="3" required></textarea>
                            <span asp-validation-for="Answer" class="text-danger small"></span>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="IconClass" class="form-label fw-bold">Bootstrap ikon Sınıfç</label>
                                <input asp-for="IconClass" class="form-control" />
                                <div class="form-text small">Mevcut ikon: <i class="bi @Model.IconClass ms-1"></i></div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DisplayOrder" class="form-label fw-bold">Göruntülenme Sırasç</label>
                                <input asp-for="DisplayOrder" type="number" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-4 form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Aktif (Yayında)</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="HelpdeskFaqs" class="btn btn-light">İptal</a>
                            <button type="submit" class="btn btn-primary fw-bold"><i class="bi bi-check-circle me-1"></i> Değişiklikleri Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
