@model OrduNet.Web.Models.Entities.Announcement
@{
    ViewData["Title"] = "Yeni Duyuru Ekle";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none text-muted">Yönetim Paneli</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Announcements" class="text-decoration-none text-muted">Duyuru Yönetimi</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Yeni Duyuru</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-megaphone-fill text-warning me-2"></i> Yeni Duyuru & Haber Ekle</h4>
                        <small class="text-muted">Ana sayfada personelin göreceği güncel kurumsal duyuru veya haberi olüsturun.</small>
                    </div>
                    <a asp-action="Announcements" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Listeye Dün
                    </a>
                </div>

                <div class="card-body p-4">
                    <form asp-action="CreateAnnouncement" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label small fw-semibold text-dark">Duyuru Bağlıçç <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Örn: 2026 Yılı Yemek Menüsç ve Sağlçk Anlağmasç" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label small fw-semibold text-dark">Kategöri <span class="text-danger">*</span></label>
                                <select asp-for="Category" id="categorySelect" class="form-select">
                                    <option value="DUYURU">DUYURU (Genel)</option>
                                    <option value="HABER">HABER (Kurumsal)</option>
                                    <option value="BçLçççM">BçLçççM & UYAP</option>
                                    <option value="İDARİ İŞLER">İDARİ İŞLER</option>
                                    <option value="KOMİSYON">KOMİSYON BAŞKANLIĞI</option>
                                    <option value="SOSYAL">SOSYAL & SAĞLIK</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BadgeClass" class="form-label small fw-semibold text-dark">Etiket Rengi</label>
                                <select asp-for="BadgeClass" id="badgeSelect" class="form-select">
                                    <option value="badge-danger">Kırmızı (Acil / Önemli)</option>
                                    <option value="badge-primary">Lacivert / Mavi (Kurumsal / Bilişim)</option>
                                    <option value="badge-warning">Sarı / Türuncu (İdari / Uyarı)</option>
                                    <option value="badge-success">Yeşil (Haber / Anlağma)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Summary" class="form-label small fw-semibold text-dark">Özet Metin (Ana Sayfada Görönecek Kısım) <span class="text-danger">*</span></label>
                            <textarea asp-for="Summary" class="form-control" rows="2" placeholder="Duyurunun ana sayfadaki kartta görönecek kısa Özeti..." required></textarea>
                            <span asp-validation-for="Summary" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label small fw-semibold text-dark">Detaylı içerik (Açıklama Metni)</label>
                            <textarea asp-for="Content" class="form-control" rows="5" placeholder="Duyurunun tüm detaylarınç buraya yazabilirsiniz..."></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="PublishDate" class="form-label small fw-semibold text-dark">Yayın Tarihi</label>
                                <input asp-for="PublishDate" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                            </div>

                            <div class="col-md-6 d-flex align-items-center pt-3">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="announcementIsActive" checked>
                                    <label class="form-check-label fw-semibold small text-dark" for="announcementIsActive">
                                        Hemen Yayına Al (Aktif)
                                    </label>
                                    <div class="form-text small">işaretlenmezse taslak olarak kaydedilir ve ana sayfada görunmez.</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Announcements" class="btn btn-outline-secondary btn-sm px-3">İptal</a>
                            <button type="submit" class="btn btn-warning btn-sm fw-bold text-dark px-4 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Duyuruyu Kaydet & Yayınla
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
