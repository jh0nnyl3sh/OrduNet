@model OrduNet.Web.Models.Entities.Announcement
@{
    ViewData["Title"] = "Duyuru Düzenle";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2 small">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none text-muted">Yönetim Paneli</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Announcements" class="text-decoration-none text-muted">Duyuru Yönetimi</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Duyuru Düzenle</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i> Duyuru Düzenle: @Model.Title</h4>
                        <small class="text-muted">Duyuru başlığını, Özetini, kategorisni veya yayın durumunu güncelleyin.</small>
                    </div>
                    <a asp-action="Announcements" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Listeye Dön
                    </a>
                </div>

                <div class="card-body p-4">
                    <form asp-action="EditAnnouncement" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ViewCount" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label small fw-semibold text-dark">Duyuru Başlığı <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label small fw-semibold text-dark">Kategori <span class="text-danger">*</span></label>
                                <select asp-for="Category" class="form-select">
                                    <option value="DUYURU">DUYURU (Genel)</option>
                                    <option value="HABER">HABER (Kurumsal)</option>
                                    <option value="BİLİŞİM">BİLİŞİM & UYAP</option>
                                    <option value="İDARİ İŞLER">İDARİ İŞLER</option>
                                    <option value="KOMİSYON">KOMİSYON BAŞKANLIĞI</option>
                                    <option value="SOSYAL">SOSYAL & SAĞLIK</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BadgeClass" class="form-label small fw-semibold text-dark">Etiket Rengi</label>
                                <select asp-for="BadgeClass" class="form-select">
                                    <option value="badge-danger">Kırmızı (Acil / Önemli)</option>
                                    <option value="badge-primary">Lacivert / Mavi (Kurumsal / Bilişim)</option>
                                    <option value="badge-warning">Sarı / Türuncu (İdari / Uyarı)</option>
                                    <option value="badge-success">Yeşil (Haber / Anlaşma)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Summary" class="form-label small fw-semibold text-dark">Özet Metin (Ana Sayfada Görünecek Kısım) <span class="text-danger">*</span></label>
                            <textarea asp-for="Summary" class="form-control" rows="2" required></textarea>
                            <span asp-validation-for="Summary" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label small fw-semibold text-dark">Detaylı içerik (Açıklama Metni)</label>
                            <textarea asp-for="Content" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="PublishDate" class="form-label small fw-semibold text-dark">Yayın Tarihi</label>
                                <input asp-for="PublishDate" type="datetime-local" class="form-control" value="@Model.PublishDate.ToString("yyyy-MM-ddTHH:mm")" />
                            </div>

                            <div class="col-md-6 d-flex align-items-center pt-3">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="announcementIsActive">
                                    <label class="form-check-label fw-semibold small text-dark" for="announcementIsActive">
                                        Yayında (Aktif)
                                    </label>
                                    <div class="form-text small">Kapatılırsa ana sayfada gizlenir.</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Announcements" class="btn btn-outline-secondary btn-sm px-3">İptal</a>
                            <button type="submit" class="btn btn-primary btn-sm px-4 shadow-sm" style="background-color: var(--primary-color);">
                                <i class="bi bi-check-lg me-1"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
