@model OrduNet.Web.Models.Entities.Announcement
@{
    ViewData["Title"] = Model.Title + " - Duyuru Detayı";
    var otherAnnouncements = ViewBag.OtherAnnouncements as List<OrduNet.Web.Models.Entities.Announcement> ?? new List<OrduNet.Web.Models.Entities.Announcement>();
}

<div class="container py-2 py-lg-3">
    <!-- Breadcrumb Navigasyon -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">
                    <i class="bi bi-house-door-fill me-1"></i> Ana Sayfa
                </a>
            </li>
            <li class="breadcrumb-item text-muted">
                <i class="bi bi-megaphone-fill me-1"></i> Duyurular
            </li>
            <li class="breadcrumb-item active text-truncate text-dark fw-semibold" aria-current="page" style="max-width: 500px;">
                @Model.Title
            </li>
        </ol>
    </nav>

    <div class="row g-3">
        <!-- SOL ANA SÜTUN: DUYURU METNİ (TEK SAYFA, KOMPAKT) -->
        <div class="col-lg-8">
            <article class="announcement-detail-card card border-0 shadow-sm rounded-3 overflow-hidden">
                <!-- üst Bağlık & Kategöri Alanı -->
                <div class="card-header bg-white border-bottom p-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @Model.BadgeClass px-3 py-1 fs-6">
                                <i class="bi bi-tag-fill me-1"></i> @Model.Category
                            </span>
                            @if (!Model.IsActive)
                            {
                                <span class="badge bg-secondary px-2 py-1 small">
                                    <i class="bi bi-eye-slash-fill me-1"></i> Taslak / Pasif
                                </span>
                            }
                        </div>

                        <!-- Hızlı İşlemler: Yazdır, Paylağ, Düzenle -->
                        <div class="d-flex align-items-center gap-2 no-print">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 d-inline-flex align-items-center gap-1" onclick="window.print();" title="Sayfayı Yazdır">
                                <i class="bi bi-printer"></i>
                                <span class="d-none d-sm-inline small">Yazdır</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 d-inline-flex align-items-center gap-1" id="btnShareLink" onclick="copyAnnouncementUrl();" title="Bağlant�y� Kopyala">
                                <i class="bi bi-share"></i>
                                <span class="d-none d-sm-inline small">Paylağ</span>
                            </button>
                            @if (User.Identity?.IsAuthenticated == true && User.HasModulePermission(SystemModules.Announcements))
                            {
                                <a asp-controller="Admin" asp-action="EditAnnouncement" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-warning text-dark fw-semibold py-1 px-2 d-inline-flex align-items-center gap-1" title="Duyuruyu Düzenle">
                                    <i class="bi bi-pencil-square"></i>
                                    <span class="d-none d-sm-inline small">Düzenle</span>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Ana Bağlık -->
                    <h1 class="announcement-detail-title h4 fw-bold text-dark mb-2" style="line-height: 1.35;">
                        @Model.Title
                    </h1>

                    <!-- Meta Bilgi çubuğu -->
                    <div class="announcement-meta-bar d-flex flex-wrap align-items-center gap-3 text-muted small pt-2 border-top">
                        <span>
                            <i class="bi bi-calendar3 text-primary me-1"></i>
                            @Model.PublishDate.ToString("dd MMMM yyyy, dddd - HH:mm")
                        </span>
                        <span>
                            <i class="bi bi-building text-primary me-1"></i>
                            T.C. Ordu Adalet Sarayı
                        </span>
                        <span>
                            <i class="bi bi-eye text-primary me-1"></i>
                            @Model.ViewCount okuma
                        </span>
                    </div>
                </div>

                <!-- Gövde Alanı (Doğrudan Duyuru Metni) -->
                <div class="card-body p-3 p-md-4">
                    <!-- Varsa Duyuru Görseli -->
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="announcement-image-wrapper mb-3 text-center rounded-3 overflow-hidden border">
                            <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid w-100" style="max-height: 300px; object-fit: cover;" />
                        </div>
                    }

                    <!-- Doğrudan Duyurunun Tamamı -->
                    <div class="announcement-full-content text-dark" style="font-size: 1rem; line-height: 1.8; white-space: pre-line;">
                        @if (!string.IsNullOrWhiteSpace(Model.Content))
                        {
                            @Model.Content
                        }
                        else
                        {
                            @Model.Summary
                        }
                    </div>
                </div>

                <!-- Kart Alt�: Butonlar -->
                <div class="card-footer bg-white border-top p-2 px-3 d-flex justify-content-between align-items-center no-print">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2 px-3">
                        <i class="bi bi-arrow-left"></i>
                        <span>Ana Sayfaya Dün</span>
                    </a>

                    <span class="text-muted small">
                        <i class="bi bi-shield-check text-success me-1"></i> OrduNet �� A� Portalı
                    </span>
                </div>
            </article>
        </div>

        <!-- SAĞ SÜTUN: D��ER GÜNCEL DUYURULAR VE �LET���M (KOMPAKT) -->
        <div class="col-lg-4 no-print">
            <div class="d-flex flex-column gap-3">
                
                <!-- Diğer GÖncel Duyurular -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-dark small d-flex align-items-center gap-2">
                            <i class="bi bi-megaphone text-warning"></i> Diğer GÖncel Duyurular
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        @if (otherAnnouncements.Any())
                        {
                            <div class="list-group list-group-flush rounded-bottom">
                                @foreach (var other in otherAnnouncements.Take(3))
                                {
                                    <a asp-controller="Home" asp-action="AnnouncementDetail" asp-route-id="@other.Id" class="list-group-item list-group-item-action p-2 px-3 border-bottom">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="badge @other.BadgeClass" style="font-size: 0.68rem;">@other.Category</span>
                                            <span class="text-muted" style="font-size: 0.7rem;">
                                                @other.PublishDate.ToString("dd.MM.yyyy")
                                            </span>
                                        </div>
                                        <div class="text-dark fw-semibold small text-truncate" style="line-height: 1.3;">
                                            @other.Title
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-3 text-center text-muted small">
                                Gösterilecek bağka güncel duyuru bulunmuyor.
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-light text-center py-2">
                        <a asp-controller="Home" asp-action="Index" class="small text-decoration-none fw-semibold text-primary">
                            <i class="bi bi-grid-fill me-1"></i> Tüm Duyurular (Ana Sayfa)
                        </a>
                    </div>
                </div>

                <!-- Hızlı İletişim & Arıza Destek -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-bold small text-dark"><i class="bi bi-headset text-primary me-1"></i> Bilgi İşlem Destek</span>
                            <span class="badge bg-success-subtle text-success small">Dahili 1050 / 1051</span>
                        </div>
                        <p class="text-muted small mb-2" style="font-size: 0.8rem;">
                            Duyurular veya teknik konular için Bilgi İşlem şefliğine arıza bildirebilirsiniz.
                        </p>
                        <button type="button" class="btn btn-warning text-dark btn-sm w-100 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#arızaModal">
                            <i class="bi bi-tools me-1"></i> Arıza Bildirimi A�
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Paylağ�m Bildirim Toast Mesajı -->
<div class="toast-container position-fixed bottom-0 end-0 p-3 no-print" style="z-index: 9999;">
    <div id="shareToast" class="toast align-items-center text-white bg-dark border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <span>Duyuru bağlant�s� panoya kopyalandı!</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyAnnouncementUrl() {
            var url = window.location.href;
            if (navigator.clipboard) {
                navigator.clipboard.writeText(url).then(function() {
                    showToast();
                }).catch(function() {
                    fallbackCopyText(url);
                });
            } else {
                fallbackCopyText(url);
            }
        }

        function fallbackCopyText(text) {
            var textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            textArea.style.left = "-9999px";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                document.execCommand('copy');
                showToast();
            } catch (err) {
                alert("Bağlant� kopyalanamadı: " + text);
            }
            document.body.removeChild(textArea);
        }

        function showToast() {
            var toastEl = document.getElementById('shareToast');
            if (toastEl && typeof bootstrap !== 'undefined') {
                var toast = new bootstrap.Toast(toastEl, { delay: 2500 });
                toast.show();
            } else {
                alert("Duyuru bağlant�s� panoya kopyalandı!");
            }
        }
    </script>
}
