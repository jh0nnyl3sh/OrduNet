@model OrduNet.Web.Models.ViewModels.CreateTicketViewModel
@{
    ViewData["Title"] = "Bilgi İşlem Arıza & Destek Bildirimi";
    Layout = "_Layout";
    
    var isAuth = User.Identity?.IsAuthenticated == true;
    var readOnlyAttr = isAuth ? "readonly" : null;
    var bgClass = isAuth ? "bg-light" : null;
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header py-2 text-center" style="background-color: var(--primary-color); color: #fff;">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-tools text-warning me-2"></i>Bilgi İşlem Arıza & Destek Bildirimi</h5>
                    <p class="mb-0 text-white-50 mt-1 small">Donanım, yazıc�, ağ veya UYAP problemleriniz için teknik servis talebi olüsturabilirsiniz.</p>
                </div>
                
                <div class="card-body p-3 bg-white">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mb-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-controller="Home" asp-action="SubmitIssueTicket" method="post">
                        @Html.AntiForgeryToken()

                        <h6 class="text-muted fw-bold mb-2 border-bottom pb-1 small">1. İletişim Bilgileri</h6>
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold text-dark mb-1">Adın�z Soyadın�z <span class="text-danger">*</span></label>
                                <input type="text" asp-for="RequesterName" class="form-control form-control-sm @bgClass" placeholder="Örn: Ahmet Yılmaz" required readonly="@readOnlyAttr" />
                                <span asp-validation-for="RequesterName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold text-dark mb-1">Dahili No <span class="text-danger">*</span></label>
                                <input type="text" asp-for="RequesterPhone" class="form-control form-control-sm @bgClass" placeholder="Örn: 2145" required readonly="@readOnlyAttr" />
                                <span asp-validation-for="RequesterPhone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold text-dark mb-1">Birim / Mahkeme <span class="text-danger">*</span></label>
                                <input type="text" asp-for="RequesterUnit" class="form-control form-control-sm @bgClass" placeholder="Örn: 1. Asliye Ceza" required readonly="@readOnlyAttr" />
                                <span asp-validation-for="RequesterUnit" class="text-danger small"></span>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold text-dark mb-1">Oda No / Kat</label>
                                <input type="text" asp-for="RoomNumber" class="form-control form-control-sm @bgClass" placeholder="Örn: Kat 2, 214" readonly="@readOnlyAttr" />
                            </div>
                            @if(isAuth)
                            {
                                <div class="col-12 mt-1">
                                    <div class="form-text small text-primary"><i class="bi bi-info-circle me-1"></i> İletişim bilgileriniz profilinizden otomatik alınm��t�r. Değiştirmek için <a asp-controller="Account" asp-action="Profile" class="fw-bold">Profilimi Düzenle</a> sayfasına gidebilirsiniz.</div>
                                </div>
                            }
                        </div>

                        <h6 class="text-muted fw-bold mb-2 border-bottom pb-1 small">2. Arıza Detayları</h6>
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold text-dark mb-1">Arıza Kategörişi <span class="text-danger">*</span></label>
                                <select asp-for="Category" class="form-select form-select-sm" required>
                                    <option value="">Kategöri Seçiniz...</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        foreach (var cat in (List<OrduNet.Web.Models.Entities.TicketCategory>)ViewBag.Categories)
                                        {
                                            <option value="@cat.Name">@cat.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold text-dark mb-1">Arıza Konusu (Özet) <span class="text-danger">*</span></label>
                                <input type="text" asp-for="Title" class="form-control form-control-sm" placeholder="Örn: Monitör ağ�lm�yor, töner bitti vb." required />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-dark mb-1">Arıza Detayı ve Açıklama <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" class="form-control form-control-sm" rows="3" placeholder="Sorunu ve varsa ald���n�z hata mesajını kısaca ağ�klay�n�z..." required></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid mt-1">
                            <button type="submit" class="btn btn-warning fw-bold text-dark shadow-sm py-2">
                                <i class="bi bi-şend-fill me-2"></i> Arıza Bildirimini Günder
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-3">
                <a asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Ana Sayfaya Dün
                </a>
            </div>
        </div>
    </div>
</div>
