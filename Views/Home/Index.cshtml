@model OrduNet.Web.Models.ViewModels.HomeDashboardViewModel
@{
    ViewData["Title"] = "Ana Sayfa - İç Ağ Portalı";
}

<div class="container py-2 py-lg-3">
    <!-- 1. HIZLI ERİŞİM KARTLARI -->
    <section class="quick-access-section mb-3">
        <div class="row g-2 g-xl-3">
            <!-- Telefon Rehberi (öne çıkan Kart) -->
            <div class="col-xl-4 col-md-6">
                <a asp-controller="Directory" asp-action="Index" class="quick-card featured">
                    <div class="quick-card-icon">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div class="quick-card-info">
                        <h3>Telefon Rehberi</h3>
                        <p>Adliye içi tüm hâkim, savcı, kalem ve personel dahili numaraları</p>
                    </div>
                </a>
            </div>

            <!-- Arıza Takip Programı -->
            <div class="col-xl-4 col-md-6">
                <a href="#arızaModal" data-bs-toggle="modal" class="quick-card">
                    <div class="quick-card-icon">
                        <i class="bi bi-tools"></i>
                    </div>
                    <div class="quick-card-info">
                        <div class="d-flex align-items-center gap-2">
                            <h3>Arıza Bildirim & Destek</h3>
                            <span class="badge bg-success font-monospace" style="font-size:0.65rem;">AKTİF</span>
                        </div>
                        <p>Bilgisayar, yazıcı, UYAP ve teknik servis arıza bildirim sistemi</p>
                    </div>
                </a>
            </div>

            <!-- İdari Yazılımlar Kafeterya Sipariş Sistemi -->
            <div class="col-xl-4 col-md-6">
                <a href="https://idariyazilimlar.adalet.gov.tr" target="_blank" rel="noopener" class="quick-card">
                    <div class="quick-card-icon">
                        <i class="bi bi-diagram-3-fill"></i>
                    </div>
                    <div class="quick-card-info">
                        <h3>Kafeterya Sipariş Sistemi</h3>
                        <p>Kafeterya Sipariş Sistemi</p>
                    </div>
                </a>
            </div>

            <!-- Günlük Yemek Menüsü -->
            <div class="col-xl-4 col-md-6">
                <a asp-controller="Duty" asp-action="Menu" class="quick-card">
                    <div class="quick-card-icon">
                        <i class="bi bi-cup-hot-fill"></i>
                    </div>
                    <div class="quick-card-info">
                        <h3>Yemek Listesi</h3>
                        <p>Haftalık ve günlük adliye personeli tabildot yemek menüsü</p>
                    </div>
                </a>
            </div>

            <!-- Nöbetçi Mahkemeler -->
            <div class="col-xl-4 col-md-6">
                <a asp-controller="Duty" asp-action="Index" class="quick-card">
                    <div class="quick-card-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="quick-card-info">
                        <h3>Nöbet Çizelgesi</h3>
                        <p>Günün nöbetçi ağır ceza, asliye ceza, sulh ceza ve savcılık birimleri</p>
                    </div>
                </a>
            </div>

            <!-- Kurumsal E-Posta -->
            <div class="col-xl-4 col-md-6">
                <a href="https://eposta.adalet.gov.tr" target="_blank" rel="noopener" class="quick-card">
                    <div class="quick-card-icon">
                        <i class="bi bi-envelope-at-fill"></i>
                    </div>
                    <div class="quick-card-info">
                        <h3>Adalet E-Posta</h3>
                        <p>T.C. Adalet Bakanlığı kurumsal e-posta gelen kutusu (@@adalet.gov.tr)</p>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- 2. ANA GÖVDE: DUYURULAR + GÜNÜN BİLGİLERİ -->
    <div class="row g-3 align-items-stretch">
        <!-- SOL SÜTUN: DUYURULAR -->
        <div class="col-lg-8 d-flex flex-column">
            <div class="section-heading">
                <h2>Duyurular</h2>
                <!-- <span class="badge bg-light text-secondary border px-3 py-2">
                    <i class="bi bi-bell-fill text-warning me-1"></i> GÖncel Bildirimler
                </span> -->
            </div>

            <!-- 2 Kart Yüksekliğinde Scroll Edilebilir Duyuru Alanı -->
            <div class="announcements-scroll-container">
                <div class="d-flex flex-column gap-2">
                    @foreach (var item in Model.Announcements)
                    {
                        <div class="announcement-card">
                            <div class="announcement-header">
                                <span class="badge @item.BadgeClass">@item.Category</span>
                                <span class="text-muted small">
                                    <i class="bi bi-clock me-1"></i> @item.PublishDate.ToString("dd.MM.yyyy")
                                </span>
                            </div>
                            <div class="announcement-body">
                                <h4>
                                    <a asp-controller="Home" asp-action="AnnouncementDetail" asp-route-id="@item.Id" class="text-decoration-none text-dark announcement-title-link">
                                        @item.Title
                                    </a>
                                </h4>
                                <p>@item.Summary</p>
                            </div>
                            <div class="announcement-footer">
                                <span><i class="bi bi-eye me-1"></i> @item.ViewCount görüntülenme</span>
                                <a asp-controller="Home" asp-action="AnnouncementDetail" asp-route-id="@item.Id" class="text-primary fw-semibold text-decoration-none announcement-detail-link">
                                    Detaylar <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SAĞ SÜTUN: GÜNÜN YEMEK MENÜSÜ BİLEŞENİ -->
        <div class="col-lg-4 d-flex flex-column"> 
            <div class="section-heading">
                <h2>Yemek Menüsü</h2>
            </div>

            <!-- GÜNÜN YEMEK MENÜSÜ KARTI -->
            @if (Model.TodayMenu != null && Model.TodayMenu.Date.Date == DateTime.Today)
            {
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden food-menu-card">
                    <div class="card-header text-white py-2 d-flex justify-content-between align-items-center" style="background-color: #1b4b57;">
                        <div class="fw-bold fs-6">
                            <i class="bi bi-cup-hot me-2 text-warning"></i> Günün Menüsü
                        </div>
                        <span class="badge bg-light text-dark">@Model.TodayMenu.DayName, @Model.TodayMenu.Date.ToString("dd.MM")</span>
                    </div>
                    <div class="card-body p-2 px-3 d-flex flex-column justify-content-between">
                        <ul class="list-unstyled mb-0 d-flex flex-column gap-1 small">
                            <li class="py-1 border-bottom d-flex align-items-start gap-2">
                                <i class="bi bi-check2-circle text-warning fs-6 mt-0.5 flex-shrink-0"></i>
                                <div>
                                    <strong class="text-muted d-block" style="font-size: 0.7rem;">Çorba</strong>
                                    <span class="text-dark fw-semibold">@Model.TodayMenu.Soup</span>
                                </div>
                            </li>
                            <li class="py-1 border-bottom d-flex align-items-start gap-2">
                                <i class="bi bi-check2-circle text-warning fs-6 mt-0.5 flex-shrink-0"></i>
                                <div>
                                    <strong class="text-primary d-block" style="font-size: 0.7rem;">Ana Yemek</strong>
                                    <span class="text-dark fw-bold">@Model.TodayMenu.MainDish</span>
                                </div>
                            </li>
                            <li class="py-1 border-bottom d-flex align-items-start gap-2">
                                <i class="bi bi-check2-circle text-warning fs-6 mt-0.5 flex-shrink-0"></i>
                                <div>
                                    <strong class="text-muted d-block" style="font-size: 0.7rem;">Yardımcı</strong>
                                    <span class="text-dark">@Model.TodayMenu.SideDish</span>
                                </div>
                            </li>
                            <li class="py-1 border-bottom d-flex align-items-start gap-2">
                                <i class="bi bi-check2-circle text-warning fs-6 mt-0.5 flex-shrink-0"></i>
                                <div>
                                    <strong class="text-muted d-block" style="font-size: 0.7rem;">Tatlı / Salata / İkram</strong>
                                    <span class="text-dark">@Model.TodayMenu.DessertOrSalad</span>
                                </div>
                            </li>
                            @if (Model.TodayMenu.Calories.HasValue)
                            {
                                <li class="pt-1 text-muted small text-end" style="font-size: 0.72rem;">
                                    <i class="bi bi-fire text-danger"></i> Toplam Enerji: ~@Model.TodayMenu.Calories kcal
                                </li>
                            }
                        </ul>

                        @if (!string.IsNullOrWhiteSpace(Model.TodayMenu.FullMenuText))
                        {
                            <div class="mt-2 pt-1 border-top">
                                <button class="btn btn-outline-secondary btn-sm w-100 py-1" type="button" data-bs-toggle="collapse" data-bs-target="#todayFullMenuCollapse" style="font-size: 0.75rem;">
                                    <i class="bi bi-card-checklist me-1 text-primary"></i> Tüm Büfe Seçenekleri (@(Model.TodayMenu.FullMenuText.Split('\n').Length) çeşit)
                                </button>
                                <div class="collapse mt-2" id="todayFullMenuCollapse">
                                    <div class="p-2 bg-light rounded small text-dark" style="max-height: 180px; overflow-y: auto;">
                                        @foreach (var item in Model.TodayMenu.FullMenuText.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <div class="d-flex align-items-center gap-1 py-0.5">
                                                <i class="bi bi-check-lg text-success small"></i>
                                                <span style="font-size: 0.75rem;">@item</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-light text-center py-1">
                        <a asp-controller="Duty" asp-action="Menu" class="text-decoration-none small fw-bold text-primary">
                            Aylık Yemek Listesi <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden food-menu-card">
                    <div class="card-header text-white py-2 d-flex justify-content-between align-items-center" style="background-color: #1b4b57;">
                        <div class="fw-bold fs-6">
                            <i class="bi bi-cup-hot me-2 text-warning"></i> Günün Menüsü
                        </div>
                        <span class="badge bg-light text-dark">@DateTime.Today.ToString("dd.MM.yyyy")</span>
                    </div>
                    <div class="card-body p-3 d-flex flex-column justify-content-center align-items-center text-center">
                        <div class="rounded-circle bg-light p-2 mb-2 text-muted">
                            <i class="bi bi-cup-straw fs-2 text-secondary"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Bugün Menü Bulunmuyor</h6>
                        <p class="text-muted small mb-2">
                            @(DateTime.Today.DayOfWeek == DayOfWeek.Saturday || DateTime.Today.DayOfWeek == DayOfWeek.Sunday ? "Hafta sonu nedeniyle yemek servişi yoktur." : "Bugünün menüsç girilmemiş veya resmi tatil olabilir.")
                        </p>
                        <a asp-controller="Duty" asp-action="Menu" class="btn btn-outline-primary btn-sm px-3">
                            <i class="bi bi-calendar3 me-1"></i> Aylık Listeyi Gör
                        </a>
                    </div>
                    <div class="card-footer bg-light text-center py-1">
                        <a asp-controller="Duty" asp-action="Menu" class="text-decoration-none small fw-bold text-primary">
                            Aylık Yemek Listesi <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

