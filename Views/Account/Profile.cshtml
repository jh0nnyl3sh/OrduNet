@model OrduNet.Web.Models.ViewModels.ProfileViewModel
@inject OrduNet.Web.Services.ISiteSettingsService SettingsService
@{
    ViewData["Title"] = "Profilimi Düzenle";
    Layout = "_Layout";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- üst Bağlık -->
                <div class="p-3 text-center text-white" style="background: linear-gradient(135deg, #153b44 0%, #1b4b57 100%);">
                    <div class="mb-2 d-inline-flex align-items-center justify-content-center" 
                         style="width: 48px; height: 48px; background: rgba(255,255,255,0.1); border-radius: 50%; border: 2px solid var(--accent-gold);">
                        <i class="bi bi-person-circle fs-4"></i>
                    </div>
                    <h5 class="fw-bold mb-1">Profil Bilgilerim</h5>
                    <p class="text-white-50 small mb-0" style="font-size: 0.8rem;">Bilgilerinizi buradan güncelleyebilir, Şifrenizi değiştirebilirsiniz.</p>
                </div>

                <!-- Form Gövdesi -->
                <div class="card-body p-3">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success py-2 small mb-3">
                            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                        <h6 class="fw-bold text-muted border-bottom pb-1 mb-2">Kişisel Bilgiler</h6>
                        <div class="row g-2 mb-3">
                            <!-- Ad Soyad -->
                            <div class="col-12">
                                <label asp-for="FullName" class="form-label small fw-bold text-secondary mb-1"></label>
                                <input asp-for="FullName" class="form-control form-control-sm" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <!-- Birim / Mahkeme -->
                            <div class="col-12">
                                <label asp-for="Unit" class="form-label small fw-bold text-secondary mb-1"></label>
                                <input asp-for="Unit" class="form-control form-control-sm" />
                                <span asp-validation-for="Unit" class="text-danger small"></span>
                            </div>

                            <!-- Dahili ve Oda No -->
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label small fw-bold text-secondary mb-1"></label>
                                <input asp-for="Phone" class="form-control form-control-sm" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RoomNumber" class="form-label small fw-bold text-secondary mb-1"></label>
                                <input asp-for="RoomNumber" class="form-control form-control-sm" />
                                <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <h6 class="fw-bold text-muted border-bottom pb-1 mb-2">Şifre Değiştir (İsteğe Bağlı)</h6>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="NewPassword" class="form-label small fw-bold text-secondary mb-1"></label>
                                <input asp-for="NewPassword" class="form-control form-control-sm" placeholder="çççççççç" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmNewPassword" class="form-label small fw-bold text-secondary mb-1"></label>
                                <input asp-for="ConfirmNewPassword" class="form-control form-control-sm" placeholder="çççççççç" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-12 text-muted small">
                                * Şifrenizi değiştirmek istemiyorsanız bu alanları boş bırakınız.
                            </div>
                        </div>

                        <!-- Kaydet Butonu -->
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light border btn-sm">
                                <i class="bi bi-arrow-left me-1"></i> İptal
                            </a>
                            <button type="submit" class="btn btn-warning px-4 py-2 fw-bold text-dark shadow-sm">
                                <i class="bi bi-save-fill me-1"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
