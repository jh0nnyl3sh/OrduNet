@model OrduNet.Web.Models.ViewModels.LoginViewModel
@inject OrduNet.Web.Services.ISiteSettingsService SettingsService
@{
    ViewData["Title"] = "Sisteme Giriş";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- üst Bağlık -->
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #153b44 0%, #1b4b57 100%);">
                    <div class="mb-3 d-inline-flex align-items-center justify-content-center" 
                         style="width: 64px; height: 64px; background: rgba(255,255,255,0.1); border-radius: 50%; border: 2px solid var(--accent-gold);">
                        <img src="~/icons/logo.svg" alt="@SettingsService.GetSetting("Header_Title", "Ordu Adliyesi")" style="width: 38px; height: 38px;" />
                    </div>
                    <h4 class="fw-bold mb-1">Sisteme Giriş</h4>
                    <p class="text-white-50 small mb-0">@SettingsService.GetSetting("Courthouse_Name_Location", "T.C. Ordu Adalet Sarayı, Alt�nordu / Ordu")</p>
                </div>

                <!-- Form Gövdesi -->
                <div class="card-body p-4">
                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                        <!-- Kullanıcı Adı -->
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label small fw-bold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-person-fill"></i>
                                </span>
                                <input asp-for="Username" class="form-control border-start-0 ps-0" placeholder="Kullanıcı adın�z� yazın�z" autofocus />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Şifre -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-bold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="��������" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Beni Hatırla -->
                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                        </div>

                        <!-- Giriş Butonu -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-warning py-2 fw-bold text-dark shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sisteme Giriş Yap
                            </button>
                        </div>

                        <div class="text-center d-flex flex-column gap-2">
                            <a asp-action="Register" class="text-decoration-none small text-primary fw-bold">
                                Hesabınız yok mu? Hemen Kayıt Olun
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none small text-muted">
                                <i class="bi bi-arrow-left me-1"></i> Ana Sayfaya Geri Dün
                            </a>
                        </div>
                    </form>
                </div>

                <!-- Alt Güvenlik Bilgilendirmesi -->
                <div class="card-footer bg-light p-3 text-center text-muted" style="font-size: 0.75rem;">
                    <i class="bi bi-shield-lock-fill text-success me-1"></i>
                    Bu panel Üzerinden hem sistem yöneticileri hem de standart personel işlem yapabilmektedir. Tüm erişimler loglanmaktadır.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
